# Discord Bot Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Required: Your Discord user ID (right-click your name > Copy User ID)
# Enables owner-only commands: //ban, //unban, //timeout, //untimeout, //restart, //shutdown, //log
OWNER_ID=0

# Optional: Claude AI integration for //ask command
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Max //ask uses per user per day (default: 20)
# ASK_DAILY_LIMIT=20

# Optional: Hours between automatic yt-dlp update checks (default: 12)
# AUTO_UPDATE_HOURS=12
